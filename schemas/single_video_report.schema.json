{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://watchbrief.local/schemas/single_video_report.schema.json",
  "title": "WatchBrief V5 Normalized Single Video Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "url",
    "channel",
    "duration",
    "date",
    "topic",
    "replacement_score",
    "tag",
    "one_line_brief",
    "watch_verdict",
    "highest_compression",
    "path_table",
    "arrow_chain",
    "final_conclusion",
    "content_caveat",
    "target_summary",
    "reading_flow",
    "target_sections",
    "watch_segments",
    "only_one_segment",
    "score_basis",
    "structured_assessment",
    "score_trace",
    "transcript_hash",
    "qwen_model_id",
    "qwen_prompt_version",
    "qwen_prompt_fingerprint",
    "codex_model",
    "codex_prompt_version",
    "codex_prompt_fingerprint",
    "scoring_formula_version",
    "watchbrief_version",
    "confidence_note"
  ],
  "properties": {
    "report_target": {
      "type": "string",
      "enum": [
        "watch_decision",
        "text_structure",
        "knowledge_notes",
        "content_brief",
        "viewpoint_breakdown",
        "creation_review"
      ]
    },
    "title": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "minLength": 1 },
    "channel": { "type": "string" },
    "duration": { "type": "string" },
    "date": { "type": "string" },
    "topic": { "type": "string", "minLength": 1 },
    "replacement_score": { "type": "number", "minimum": 0, "maximum": 10 },
    "tag": {
      "type": "string",
      "enum": [
        "报告足够替代",
        "报告基本可替代",
        "只建议跳看",
        "值得补看",
        "建议完整看",
        "不推荐观看",
        "解析不足"
      ]
    },
    "one_line_brief": { "type": "string", "pattern": "^这期视频主要讲：" },
    "watch_verdict": { "type": "string", "minLength": 1 },
    "highest_compression": { "type": "string", "minLength": 1 },
    "path_table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem", "mechanism", "turning_point", "landing"],
      "properties": {
        "problem": { "type": "string", "minLength": 1 },
        "mechanism": { "type": "string", "minLength": 1 },
        "turning_point": { "type": "string", "minLength": 1 },
        "landing": { "type": "string", "minLength": 1 }
      }
    },
    "arrow_chain": {
      "type": "array",
      "minItems": 5,
      "maxItems": 7,
      "items": { "type": "string", "minLength": 1, "maxLength": 18 }
    },
    "final_conclusion": { "type": "string", "minLength": 1 },
    "content_caveat": { "type": "string" },
    "reading_flow": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end", "heading", "body"],
        "properties": {
          "start": { "type": "string", "minLength": 1 },
          "end": { "type": "string", "minLength": 1 },
          "heading": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 }
        }
      }
    },
    "watch_segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "start", "end", "title", "reason"],
        "properties": {
          "priority": { "type": "string", "enum": ["primary", "optional", "backup"] },
          "start": { "type": "string", "minLength": 1 },
          "end": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "long_content_breakdown": {
      "type": "array",
      "minItems": 2,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end", "title", "summary"],
        "properties": {
          "start": { "type": "string", "minLength": 1 },
          "end": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "only_one_segment": { "type": "string", "minLength": 1 },
    "score_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["information_density", "evidence_quality", "topic_interest"],
      "properties": {
        "information_density": { "type": "string", "minLength": 1 },
        "evidence_quality": { "type": "string", "minLength": 1 },
        "topic_interest": { "type": "string", "minLength": 1 }
      }
    },
    "structured_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["信息密度", "论据质量", "话题兴趣"],
      "properties": {
        "信息密度": { "type": "number", "minimum": 0, "maximum": 10 },
        "论据质量": { "type": "number", "minimum": 0, "maximum": 10 },
        "话题兴趣": { "type": "number", "minimum": 0, "maximum": 10 }
      }
    },
    "score_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "information_density",
        "evidence_quality",
        "topic_interest",
        "formula",
        "computed_replacement_score",
        "model_suggested_score",
        "final_score_source",
        "score_semantics"
      ],
      "properties": {
        "information_density": { "type": "number", "minimum": 0, "maximum": 10 },
        "evidence_quality": { "type": "number", "minimum": 0, "maximum": 10 },
        "topic_interest": { "type": "number", "minimum": 0, "maximum": 10 },
        "formula": {
          "type": "string",
          "minLength": 1
        },
        "computed_replacement_score": { "type": "number", "minimum": 0, "maximum": 10 },
        "model_suggested_score": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
        "final_score_source": {
          "type": "string",
          "enum": ["deterministic_formula"]
        },
        "score_semantics": {
          "type": "string",
          "enum": ["content_quality_with_topic_interest"]
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "transcript_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "visual_evidence_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "visual_provider": { "type": "string", "enum": ["mimo-vl-mlx"] },
    "visual_prompt_version": { "type": "string", "enum": ["watchbrief_v5.mimo_visual_prompt.v1"] },
    "qwen_model_id": { "type": "string", "minLength": 1 },
    "qwen_prompt_version": { "type": "string", "minLength": 1 },
    "qwen_prompt_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "codex_model": { "type": "string", "minLength": 1 },
    "codex_prompt_version": { "type": "string", "minLength": 1 },
    "codex_prompt_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "scoring_formula_version": { "type": "string", "minLength": 1 },
    "watchbrief_version": { "type": "string", "enum": ["watchbrief_v6"] },
    "confidence_note": { "type": "string", "minLength": 1 },
    "personal_relevance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "basis",
        "match_level",
        "topic_interest_score",
        "summary",
        "evidence",
        "caveat",
        "profile_schema_version",
        "profile_sha256"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["matched", "no_match", "insufficient_profile"]
        },
        "basis": {
          "type": "string",
          "enum": ["watchtrace_bilibili_profile"]
        },
        "match_level": {
          "type": "string",
          "enum": ["interest_domain_match", "no_interest_domain_match", "insufficient_interest_profile"]
        },
        "topic_interest_score": { "type": "number", "minimum": 0, "maximum": 10 },
        "summary": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1 }
        },
        "caveat": { "type": "string", "minLength": 1 },
        "profile_schema_version": { "type": "string", "minLength": 1 },
        "profile_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "target_summary": { "type": "string", "minLength": 1 },
    "target_sections": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 6,
        "items": { "type": "string", "minLength": 1 }
      }
    }
  }
}
